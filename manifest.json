{
  "manifest_version": 3,
  "name": "Sentry Check — Web Security Auditor",
  "version": "1.1.0",
  "description": "Audits the current page's security headers, cookies, mixed content, and JS library vulnerabilities.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["vulndb.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "webRequest",
    "cookies",
    "activeTab",
    "storage",
    "scripting",
    "webNavigation",
    "notifications"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "sentry-check@portfolio.local",
      "strict_min_version": "115.0"
    }
  }
}
